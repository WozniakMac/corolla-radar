        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "carId": { "type": "string", "minLength": 1 },
          "recommendation": {
            "type": "string",
            "enum": ["kup", "shortlista", "sprawdź", "odrzuć"]
          },
          "purchaseScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
